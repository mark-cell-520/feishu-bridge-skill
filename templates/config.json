{
  "bots": [
    {
      "name": "claude-code",
      "app_id": "${FEISHU_APP_ID}",
      "app_secret": "${FEISHU_APP_SECRET}",
      "workspace": "$HOME/.local/share/feishu-bridge/workspaces/claude-code",
      "allowed_users": ["*"]
    }
  ],
  "agent": {
    "type": "claude",
    "command": "$HOME/.npm-global/bin/claude",
    "timeout_seconds": 300,
    "args": ["--permission-mode", "bypassPermissions"]
  }
}
